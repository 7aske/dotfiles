set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 0
set selection-clipboard clipboard
set window-title-basename true
set statusbar-home-tilde true
set show-scrollbars false
set recolor true
set recolor-keephue false

map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print

# Nord — https://github.com/arcticicestudio/nord/issues/143
# Use rgba for highlight-* so selection/search overlays stay readable.

set default-bg                  "#2E3440"
set default-fg                  "#D8DEE9"

set statusbar-bg                "#2E3440"
set statusbar-fg                "#D8DEE9"

set inputbar-bg                 "#2E3440"
set inputbar-fg                 "#A3BE8C"

set notification-bg             "#3B4252"
set notification-fg             "#ECEFF4"

set notification-error-bg       "#BF616A"
set notification-error-fg       "#ECEFF4"

set notification-warning-bg     "#EBCB8B"
set notification-warning-fg       "#2E3440"

set highlight-color             "rgba(94, 129, 172, 0.45)"
set highlight-active-color      "rgba(136, 192, 208, 0.55)"
set highlight-fg                "rgba(46, 52, 64, 0.65)"

set completion-bg               "#2E3440"
set completion-fg               "#D8DEE9"

set completion-highlight-bg     "#434C5E"
set completion-highlight-fg     "#ECEFF4"

set index-bg                    "#2E3440"
set index-fg                    "#D8DEE9"
set index-active-bg             "#434C5E"
set index-active-fg             "#D8DEE9"

set recolor-lightcolor          "#2E3440"
set recolor-darkcolor           "#ECEFF4"

set render-loading-bg           "#2E3440"
set render-loading-fg           "#D8DEE9"
